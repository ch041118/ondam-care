# Copy to .env.public in the project root.
# The HTTPS domain assigned to your free ngrok account (not an example URL).
PUBLIC_ORIGIN=https://your-assigned-name.ngrok-free.app
PORT=3000
# Optional absolute path if ngrok is not on PATH.
# NGROK_PATH=C:/tools/ngrok.exe
