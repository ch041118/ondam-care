{
  "name": "clover-care",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/start-local.mjs",
    "test": "node --test test/*.test.mjs",
    "build:mobile": "node scripts/build-mobile.mjs",
    "sync:mobile": "npm run build:mobile && cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "android:apk": "npm run sync:mobile && node scripts/build-android.mjs",
    "verify:mobile": "node scripts/verify-mobile.mjs",
    "build:expo": "npm --prefix expo run export",
    "expo": "npm --prefix expo start",
    "expo:check": "npm run build:expo",
    "account:social": "node scripts/create-social.mjs",
    "build:expo-demo": "node scripts/build-expo.mjs",
    "account:admin": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "start:lan": "node --env-file-if-exists=.env scripts/start-lan.mjs",
    "start:public": "node scripts/start-public.mjs",
    "start:domain": "node scripts/start-domain.mjs",
    "prestart:domain": "npm run build:web",
    "build:web": "node scripts/build-web.mjs",
    "prestart": "npm run build:web",
    "prestart:public": "npm run build:web",
    "prestart:lan": "npm run build:web",
    "test:mock": "node --test test/mock-*.test.mjs test/request-review.test.mjs",
    "evaluate:voice": "node --env-file-if-exists=.env scripts/evaluate-voice.mjs"
    ,"evaluate:rubric": "node scripts/evaluate-rubric.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.2",
    "@capgo/capacitor-audio-recorder": "8.2.9"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
