PORT=3000
# Local OpenAI-compatible speech-to-text endpoint; audio is not stored by this app.
# STT_URL=http://127.0.0.1:8000/v1/audio/transcriptions
# STT_MODEL=whisper-1
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=your-installed-model
# Agent defaults to OLLAMA_MODEL. Override independently when needed.
# AGENT_PROVIDER=ollama
# AGENT_MODEL=your-installed-model
# Optional compatible chat-completions endpoint (configuration alone does not verify service health).
# AGENT_PROVIDER=openai-compatible
# AGENT_BASE_URL=https://your-approved-provider.example/v1
# AGENT_API_KEY=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# Optional background wellness push providers (server only).
# Use private credential files outside the repository.
# FCM_SERVICE_ACCOUNT_FILE=C:/private/clover-firebase-service-account.json
# APNS_KEY_FILE=C:/private/AuthKey_example.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=kr.clover.care
# APNS_ENVIRONMENT=sandbox

# Optional HTTPS reverse-proxy origin for phone login (HOST controls the bind address).
# PUBLIC_ORIGIN=https://care.example.org
# Separate persistent data directory; keep outside publicly served folders.
# CLOVER_DATA_DIR=C:/private/clover-data

# Container/public deployment only; leave unset for local PC use.
# HOST=0.0.0.0
# NODE_ENV=production
# TRUST_PROXY=true
